# Copy to .env outside version control and replace every change-me value.
AILOG_SERVER_PORT=8080
AILOG_MYSQL_URL=jdbc:mysql://db-host:3306/database?useUnicode=true&characterEncoding=utf8&serverTimezone=Asia/Shanghai&useSSL=false&allowPublicKeyRetrieval=true
AILOG_MYSQL_USERNAME=change-me
AILOG_MYSQL_PASSWORD=change-me
AILOG_REDIS_HOST=redis-host
AILOG_REDIS_PORT=6379
AILOG_REDIS_PASSWORD=change-me
AILOG_REDIS_DATABASE=0
AILOG_ROCKETMQ_NAME_SERVER=rocketmq-host:9876
AILOG_RUSTFS_ENDPOINT=http://rustfs-host:9001
AILOG_RUSTFS_ACCESS_KEY=change-me
AILOG_RUSTFS_SECRET_KEY=change-me
AILOG_RUSTFS_BUCKET=change-me
AILOG_MCP_DOCKER_RESTART_ENABLED=false
AILOG_MCP_RUSTFS_DELETE_ENABLED=false
AILOG_DASHBOARD_ALLOWED_ORIGINS=http://localhost:5173
